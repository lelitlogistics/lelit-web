---
const pillars=[{n:'01',title:'Last-mile delivery',body:'Standard parcel, oversize, and same-day routes across central Connecticut, dispatched and tracked end to end.'},{n:'02',title:'Safety first, always',body:'Netradyne in every van, daily vehicle inspections, and coaching built into the week — not bolted on after an incident.'},{n:'03',title:'Real driver training',body:'New drivers ride before they run routes. Clear expectations, real support, and the tools to grow with us.'},{n:'04',title:'Tech that keeps us moving',body:'In-house tools for scheduling, fleet maintenance, and performance keep the operation tight and every van road-ready.'}];
const stats=[{count:6000,suffix:'+',label:'packages delivered daily'},{count:20,suffix:'+',label:'routes every day'},{count:99,suffix:'%',label:'on-time delivery target'},{count:35,suffix:'',label:'drivers on the road daily'}];
const fleetImage='https://assets.aboutamazon.com/4d/42/70dec02640579454676e5159b4f8/rivian-hero-2000x1126-2.jpg';
---
<section class="op" id="operation"><div class="wrap"><div class="op__head" data-reveal><span class="eyebrow">The operation</span><h2>Built to run clean, every single day.</h2></div><div class="op__stats" data-reveal>{stats.map(s=><div class="stat"><span class="stat__v grad" data-count={s.count} data-suffix={s.suffix}>0</span><span class="stat__l">{s.label}</span></div>)}</div></div><div class="fleet" data-reveal><img src={fleetImage} alt="Amazon Rivian electric delivery van on route" loading="lazy"/><div class="fleet__veil"></div><div class="wrap fleet__inner"><div class="fleet__copy"><span class="eyebrow">Modern fleet</span><h3>Technology that moves with us.</h3><p>Electric vehicles, connected systems, and a safety-first operation built for the last mile.</p><span class="fleet__line">DOB7 · GLASTONBURY, CONNECTICUT</span></div></div></div><div class="wrap"><div class="op__grid">{pillars.map((p,i)=><article class="pillar" data-reveal style={`transition-delay:${i*70}ms`}><span class="pillar__n">{p.n}</span><h3>{p.title}</h3><p>{p.body}</p></article>)}</div></div></section>
<style>
.op{padding-block:clamp(4.5rem,10vw,8rem);position:relative}.op__head h2{font-size:clamp(2rem,5vw,3.6rem);margin-top:1.1rem;max-width:16ch}.op__stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;margin:clamp(2.5rem,6vw,4rem) 0;padding-block:2rem;border-block:1px solid var(--line)}.stat{display:flex;flex-direction:column;gap:.3rem}.stat__v{font-family:var(--font-display);font-size:clamp(2.2rem,5vw,3.4rem);letter-spacing:-.03em}.stat__l{font-size:.85rem;color:var(--fg-faint)}.fleet{position:relative;width:100%;height:clamp(480px,61vw,720px);overflow:hidden;margin:0 0 clamp(3rem,6vw,5rem)}.fleet img{position:absolute;inset:-2%;width:104%;height:104%;object-fit:cover;object-position:62% 52%;transition:transform 1.5s var(--ease),filter .8s var(--ease);filter:saturate(.9) brightness(.8)}.fleet:hover img{transform:scale(1.018);filter:saturate(1) brightness(.83)}.fleet__veil{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,9,14,.92) 0%,rgba(4,9,14,.62) 32%,rgba(4,9,14,.15) 62%,rgba(4,9,14,.02) 82%),linear-gradient(0deg,var(--bg) 0%,transparent 16%,transparent 82%,var(--bg) 100%)}.fleet__inner{position:relative;height:100%;display:flex;align-items:center}.fleet__copy{max-width:490px}.fleet__copy h3{font-size:clamp(2.5rem,5.5vw,4.8rem);line-height:.94;margin:.8rem 0 1rem}.fleet__copy p{color:var(--fg-soft);font-size:1.08rem;max-width:38ch}.fleet__line{display:inline-block;margin-top:2rem;padding-top:.8rem;border-top:1px solid rgba(255,255,255,.2);font-size:.68rem;letter-spacing:.16em;color:rgba(255,255,255,.6)}.op__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.4rem}.pillar{border:1px solid var(--line);border-radius:var(--radius);padding:1.8rem;background:var(--surface);transition:border-color .4s var(--ease),transform .4s var(--ease),background .4s var(--ease)}.pillar:hover{border-color:rgba(248,120,0,.5);transform:translateY(-4px);background:var(--surface-2)}.pillar__n{font-family:var(--font-display);color:var(--orange-soft);font-size:.95rem;letter-spacing:.1em}.pillar h3{font-size:1.5rem;margin:.7rem 0 .6rem}.pillar p{color:var(--fg-soft);font-size:.98rem}@media(max-width:760px){.op__stats{grid-template-columns:repeat(2,1fr);gap:1.8rem 1.2rem}.op__grid{grid-template-columns:1fr}.fleet{height:590px}.fleet img{object-position:66% center}.fleet__veil{background:linear-gradient(0deg,rgba(4,9,14,.96) 0%,rgba(4,9,14,.58) 47%,rgba(4,9,14,.08) 76%),linear-gradient(180deg,var(--bg),transparent 18%)}.fleet__inner{align-items:flex-end;padding-bottom:4rem}}
</style>