---
const roles=[{n:'01',title:'Full-Time Driver',tag:'Now hiring',summary:'The core of the operation. Run a route, treat the customer right, get home safe.',rows:[['Schedule','4 days / week'],['Hours','10 hrs per day'],['Weekend','One weekend day required'],['Pay','$23.25 / hr + OT']]},{n:'02',title:'Part-Time Driver',tag:'Now hiring',summary:'Fewer days, same standard. A great fit if you want a lighter, flexible week.',rows:[['Schedule','3 days / week'],['Hours','10 hrs per day'],['Type','Part-time'],['Pay','$23.25 / hr']]}];
const perks=['Competitive hourly pay with weekly overtime','Paid training before you ever run solo','Fantastic Plus performance bonuses','Gas card incentives for eligible roles','Clear schedules — you know your week ahead','A real path to grow as the company grows'];
const benefits=['Health, vision, and dental insurance','Retirement program','Referral program'];
const driverImage='https://assets.aboutamazon.com/dims4/default/f5765f2/2147483647/strip/true/crop/1999x1125%2B1%2B0/resize/1240x698%21/quality/90/?url=https%3A%2F%2Famazon-blogs-brightspot.s3.amazonaws.com%2F9c%2F7b%2F5e02715f4a97b4c27100614cafc2%2Fhero3.jpg';
---
<section class="careers" id="careers"><div class="career-hero" data-reveal><div class="career-hero__photo"><img src={driverImage} alt="Amazon delivery associate with an electric delivery van" loading="eager" decoding="async"/></div><div class="career-hero__veil"></div><div class="wrap career-hero__inner"><div class="career-hero__copy"><span class="eyebrow">Drive with us</span><h2>Drive your future.</h2><p>Join a supportive team, drive a modern fleet, and be part of a company that values people.</p><div class="career-hero__facts"><div><strong>$23.25/hr</strong><span>Competitive pay</span></div><div><strong>4-Day</strong><span>Full-time week</span></div><div><strong>Benefits</strong><span>Medical · Dental · Vision</span></div><div><strong>Paid</strong><span>Training</span></div></div><a href="#open-roles" class="btn btn--orange">View open roles <span class="arrow">↘</span></a></div></div><span class="career-hero__caption">DELIVERY ASSOCIATES · CENTRAL CONNECTICUT</span></div><div class="wrap"><div class="careers__head" id="open-roles" data-reveal><span class="eyebrow">Open roles</span><h2>Find your schedule.</h2><p>We hire for reliability and attitude. The route, the van, and the training — that part is on us.</p></div><div class="careers__grid">{roles.map((r,i)=><article class="role" data-reveal style={`transition-delay:${i*80}ms`}><div class="role__top"><span class="role__n">{r.n}</span><span class="role__tag role__tag--hot">{r.tag}</span></div><h3>{r.title}</h3><p class="role__summary">{r.summary}</p><dl class="role__rows">{r.rows.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl><a href="#contact" class="role__cta">Apply <span class="arrow">↗</span></a></article>)}</div><div class="benefits" data-reveal><h3>Benefits</h3><div class="benefits__grid">{benefits.map(b=><div class="benefit"><span class="benefit__icon">+</span>{b}</div>)}</div></div><div class="perks" data-reveal><h3>Why drivers stay</h3><ul>{perks.map(p=><li>{p}</li>)}</ul><p class="perks__note">Questions before you apply? Email <a href="mailto:hiring@lelitlogistics.com">hiring@lelitlogistics.com</a>.</p></div></div></section>
<style>
.careers{padding-bottom:clamp(4.5rem,10vw,8rem);border-top:1px solid var(--line);background:var(--bg-2)}.career-hero{position:relative;width:100%;height:clamp(590px,66vw,780px);overflow:hidden;margin-bottom:clamp(4rem,8vw,7rem);background:var(--bg-2)}.career-hero__photo{position:absolute;inset:0}.career-hero__photo>img{width:100%;height:100%;object-fit:cover;object-position:66% center;filter:saturate(1.02) contrast(1.02)}.career-hero__veil{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,10,15,.9) 0%,rgba(5,10,15,.68) 28%,rgba(5,10,15,.24) 52%,rgba(5,10,15,.03) 75%),linear-gradient(0deg,var(--bg-2) 0%,transparent 12%,transparent 90%,var(--bg-2) 100%)}.career-hero__inner{position:relative;height:100%;display:flex;align-items:center}.career-hero__copy{max-width:590px}.career-hero__copy h2{font-size:clamp(3rem,7vw,5.7rem);line-height:.93;margin:1rem 0 1.2rem}.career-hero__copy>p{color:var(--fg-soft);font-size:1.1rem;max-width:42ch}.career-hero__facts{display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem;margin:2rem 0}.career-hero__facts div{display:flex;flex-direction:column;border-left:2px solid var(--orange);padding-left:.8rem}.career-hero__facts strong{font-family:var(--font-display);font-size:1.25rem}.career-hero__facts span{font-size:.76rem;color:var(--fg-faint)}.career-hero__copy .btn{display:inline-flex}.career-hero__caption{position:absolute;right:clamp(1rem,3vw,2.5rem);bottom:2rem;font-size:.64rem;letter-spacing:.16em;color:rgba(255,255,255,.58)}.careers__head{max-width:52ch;margin-bottom:clamp(2rem,5vw,3.5rem);scroll-margin-top:100px}.careers__head h2{font-size:clamp(2.4rem,6vw,4.2rem);margin:1rem 0 .8rem}.careers__head p{color:var(--fg-soft);font-size:1.1rem}.careers__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.3rem}.role{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:var(--radius);padding:1.7rem;background:var(--surface);transition:transform .45s var(--ease),box-shadow .45s var(--ease),border-color .45s var(--ease)}.role:hover{transform:translateY(-6px);border-color:var(--orange);box-shadow:0 24px 50px -28px rgba(248,120,0,.4)}.role__top{display:flex;justify-content:space-between;align-items:center}.role__n{font-family:var(--font-display);color:var(--fg-faint);font-size:1rem;letter-spacing:.1em}.role__tag{font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:.35em .7em;border-radius:100px}.role__tag--hot{color:var(--orange-soft);background:rgba(248,120,0,.14)}.role h3{font-size:1.65rem;margin:1rem 0 .5rem}.role__summary{color:var(--fg-soft);font-size:.96rem;margin-bottom:1.3rem}.role__rows{display:flex;flex-direction:column;margin-top:auto}.role__rows>div{display:flex;justify-content:space-between;gap:1rem;padding:.6rem 0;border-top:1px solid var(--line-soft)}.role__rows dt{color:var(--fg-faint);font-size:.82rem}.role__rows dd{font-weight:600;font-size:.92rem;text-align:right}.role__cta{display:inline-flex;align-items:center;gap:.5em;margin-top:1.4rem;font-weight:600;color:var(--orange-soft);transition:gap .3s var(--ease)}.role:hover .role__cta{gap:.8em}.benefits,.perks{margin-top:1.3rem;border:1px solid var(--line);border-radius:var(--radius);padding:clamp(1.8rem,4vw,2.8rem);background:var(--surface)}.benefits{background:radial-gradient(circle at 0 0,rgba(248,120,0,.1),transparent 42%),var(--surface)}.benefits h3,.perks h3{font-size:1.8rem;margin-bottom:1.4rem}.benefits__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.benefit{display:flex;align-items:center;gap:.7rem;border:1px solid var(--line);border-radius:12px;padding:1rem 1.2rem;font-weight:500;background:var(--bg-2)}.benefit__icon{width:26px;height:26px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;background:rgba(32,136,248,.16);color:var(--blue-soft);font-weight:700}.perks{background:radial-gradient(circle at 100% 0,rgba(32,136,248,.1),transparent 42%),var(--surface)}.perks ul{list-style:none;display:grid;grid-template-columns:repeat(2,1fr);gap:.9rem 2rem}.perks li{position:relative;padding-left:1.8rem;color:var(--fg-soft)}.perks li::before{content:'→';position:absolute;left:0;color:var(--orange);font-weight:700}.perks__note{margin-top:1.6rem;font-size:.95rem;color:var(--fg-faint)}.perks__note a{color:var(--blue-soft);font-weight:600;border-bottom:1px solid currentColor}
@media(max-width:880px){.career-hero{height:auto;overflow:visible;display:flex;flex-direction:column;margin-bottom:4rem}.career-hero__photo{position:relative;inset:auto;order:1;width:100%;aspect-ratio:4/3;overflow:hidden}.career-hero__photo>img{display:block;object-position:68% center}.career-hero__veil{display:none}.career-hero__inner{order:2;height:auto;display:block;padding-top:1.75rem;padding-bottom:0}.career-hero__copy{max-width:none}.career-hero__copy h2{font-size:clamp(3rem,12vw,4.4rem);margin:.75rem 0 1rem}.career-hero__copy>p{font-size:1rem}.career-hero__facts{margin:1.6rem 0}.career-hero__caption{display:none}.careers__grid,.benefits__grid{grid-template-columns:1fr}}
@media(max-width:620px){.career-hero__photo{aspect-ratio:1/1}.career-hero__photo>img{object-position:70% center}.career-hero__facts{grid-template-columns:1fr 1fr;gap:1rem}.career-hero__copy .btn{width:100%;justify-content:center}.perks ul{grid-template-columns:1fr}.role{padding:1.4rem}}
@media(max-width:420px){.career-hero__facts{grid-template-columns:1fr 1fr}.career-hero__facts strong{font-size:1.08rem}}
</style>