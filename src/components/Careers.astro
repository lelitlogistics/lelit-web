---
const roles=[{n:'01',title:'Full-Time Driver',tag:'Now hiring',summary:'The core of the operation. Run a route, treat the customer right, get home safe.',rows:[['Schedule','4 days / week'],['Hours','10 hrs per day'],['Weekend','One weekend day required'],['Pay','$23.25 / hr + OT']]},{n:'02',title:'Part-Time Driver',tag:'Now hiring',summary:'Fewer days, same standard. A great fit if you want a lighter, flexible week.',rows:[['Schedule','3 days / week'],['Hours','10 hrs per day'],['Type','Part-time'],['Pay','$23.25 / hr']]}];
const perks=['Competitive hourly pay with weekly overtime','Paid training before you ever run solo','Fantastic Plus performance bonuses','Gas card incentives for eligible roles','Clear schedules — you know your week ahead','A real path to grow as the company grows'];
const benefits=['Health, vision, and dental insurance','Retirement program','Referral program'];
const driverImage='https://assets.aboutamazon.com/dims4/default/55a9346/2147483647/strip/true/crop/1600x900%2B0%2B0/resize/1320x743%21/quality/90/?url=https%3A%2F%2Fassets.aboutamazon.com%2Fdd%2Ffb%2Faee9e53c4d4eadb9906845d33b2f%2Famazon-delivery-driver-delivers-package.jpg';
---
<section class="careers" id="careers"><div class="wrap"><div class="career-hero" data-reveal><div class="career-hero__copy"><span class="eyebrow">Drive with us</span><h2>Drive your future.</h2><p>Join a supportive team, drive a modern fleet, and be part of a company that values people.</p><div class="career-hero__facts"><div><strong>$23.25/hr</strong><span>Competitive pay</span></div><div><strong>4-Day</strong><span>Full-time week</span></div><div><strong>Benefits</strong><span>Medical · Dental · Vision</span></div><div><strong>Paid</strong><span>Training</span></div></div><a href="#open-roles" class="btn btn--orange">View open roles <span class="arrow">↘</span></a></div><div class="career-hero__photo"><img src={driverImage} alt="Delivery associate working from an Amazon Rivian electric delivery van" loading="lazy"/><div class="career-hero__shade"></div></div></div><div class="careers__head" id="open-roles" data-reveal><span class="eyebrow">Open roles</span><h2>Find your schedule.</h2><p>We hire for reliability and attitude. The route, the van, and the training — that part is on us.</p></div><div class="careers__grid">{roles.map((r,i)=><article class="role" data-reveal style={`transition-delay:${i*80}ms`}><div class="role__top"><span class="role__n">{r.n}</span><span class="role__tag role__tag--hot">{r.tag}</span></div><h3>{r.title}</h3><p class="role__summary">{r.summary}</p><dl class="role__rows">{r.rows.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl><a href="#contact" class="role__cta">Apply <span class="arrow">↗</span></a></article>)}</div><div class="benefits" data-reveal><h3>Benefits</h3><div class="benefits__grid">{benefits.map(b=><div class="benefit"><span class="benefit__icon">+</span>{b}</div>)}</div></div><div class="perks" data-reveal><h3>Why drivers stay</h3><ul>{perks.map(p=><li>{p}</li>)}</ul><p class="perks__note">Questions before you apply? Email <a href="mailto:hiring@lelitlogistics.com">hiring@lelitlogistics.com</a>.</p></div></div></section>
<style>
.careers{padding-block:clamp(4.5rem,10vw,8rem);border-top:1px solid var(--line);background:var(--bg-2)}.career-hero{display:grid;grid-template-columns:.95fr 1.05fr;min-height:520px;border:1px solid var(--line);border-radius:calc(var(--radius) + 8px);overflow:hidden;background:var(--surface);margin-bottom:clamp(4rem,8vw,7rem)}.career-hero__copy{padding:clamp(2rem,5vw,4.5rem);display:flex;flex-direction:column;justify-content:center}.career-hero__copy h2{font-size:clamp(2.8rem,6vw,5rem);line-height:.95;margin:1rem 0 1.2rem}.career-hero__copy>p{color:var(--fg-soft);font-size:1.08rem;max-width:42ch}.career-hero__facts{display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem;margin:2rem 0}.career-hero__facts div{display:flex;flex-direction:column;border-left:2px solid var(--orange);padding-left:.8rem}.career-hero__facts strong{font-family:var(--font-display);font-size:1.25rem}.career-hero__facts span{font-size:.76rem;color:var(--fg-faint)}.career-hero__copy .btn{align-self:flex-start}.career-hero__photo{position:relative;min-height:420px;overflow:hidden}.career-hero__photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.1s var(--ease),filter .8s var(--ease);filter:saturate(.82)}.career-hero:hover img{transform:scale(1.025);filter:saturate(1)}.career-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,13,18,.4),transparent 40%)}.careers__head{max-width:52ch;margin-bottom:clamp(2rem,5vw,3.5rem);scroll-margin-top:100px}.careers__head h2{font-size:clamp(2.4rem,6vw,4.2rem);margin:1rem 0 .8rem}.careers__head p{color:var(--fg-soft);font-size:1.1rem}.careers__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.3rem}.role{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:var(--radius);padding:1.7rem;background:var(--surface);transition:transform .45s var(--ease),box-shadow .45s var(--ease),border-color .45s var(--ease)}.role:hover{transform:translateY(-6px);border-color:var(--orange);box-shadow:0 24px 50px -28px rgba(248,120,0,.4)}.role__top{display:flex;justify-content:space-between;align-items:center}.role__n{font-family:var(--font-display);color:var(--fg-faint);font-size:1rem;letter-spacing:.1em}.role__tag{font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:.35em .7em;border-radius:100px}.role__tag--hot{color:var(--orange-soft);background:rgba(248,120,0,.14)}.role h3{font-size:1.65rem;margin:1rem 0 .5rem}.role__summary{color:var(--fg-soft);font-size:.96rem;margin-bottom:1.3rem}.role__rows{display:flex;flex-direction:column;margin-top:auto}.role__rows>div{display:flex;justify-content:space-between;gap:1rem;padding:.6rem 0;border-top:1px solid var(--line-soft)}.role__rows dt{color:var(--fg-faint);font-size:.82rem}.role__rows dd{font-weight:600;font-size:.92rem;text-align:right}.role__cta{display:inline-flex;align-items:center;gap:.5em;margin-top:1.4rem;font-weight:600;color:var(--orange-soft);transition:gap .3s var(--ease)}.role:hover .role__cta{gap:.8em}.benefits,.perks{margin-top:1.3rem;border:1px solid var(--line);border-radius:var(--radius);padding:clamp(1.8rem,4vw,2.8rem);background:var(--surface)}.benefits{background:radial-gradient(circle at 0 0,rgba(248,120,0,.1),transparent 42%),var(--surface)}.benefits h3,.perks h3{font-size:1.8rem;margin-bottom:1.4rem}.benefits__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.benefit{display:flex;align-items:center;gap:.7rem;border:1px solid var(--line);border-radius:12px;padding:1rem 1.2rem;font-weight:500;background:var(--bg-2)}.benefit__icon{width:26px;height:26px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;background:rgba(32,136,248,.16);color:var(--blue-soft);font-weight:700}.perks{background:radial-gradient(circle at 100% 0,rgba(32,136,248,.1),transparent 42%),var(--surface)}.perks ul{list-style:none;display:grid;grid-template-columns:repeat(2,1fr);gap:.9rem 2rem}.perks li{position:relative;padding-left:1.8rem;color:var(--fg-soft)}.perks li::before{content:'→';position:absolute;left:0;color:var(--orange);font-weight:700}.perks__note{margin-top:1.6rem;font-size:.95rem;color:var(--fg-faint)}.perks__note a{color:var(--blue-soft);font-weight:600;border-bottom:1px solid currentColor}@media(max-width:880px){.career-hero{grid-template-columns:1fr}.career-hero__photo{order:-1;min-height:55vw}.careers__grid,.benefits__grid{grid-template-columns:1fr}}@media(max-width:620px){.career-hero__facts,.perks ul{grid-template-columns:1fr 1fr}.career-hero__copy{padding:1.6rem}.career-hero__photo{min-height:330px}}@media(max-width:420px){.career-hero__facts{grid-template-columns:1fr}}
</style>