---
const heroImage = 'https://assets.aboutamazon.com/4d/42/70dec02640579454676e5159b4f8/rivian-hero-2000x1126-2.jpg';
---
<section class="hero" id="main">
  <div class="hero__media" aria-hidden="true"><img src={heroImage} alt="" fetchpriority="high"/><div class="hero__wash"></div></div>
  <div class="hero__bg" aria-hidden="true"><div class="hero__grid"></div><div class="hero__glow"></div></div>
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <span class="pill stagger" style="--d:0"><span class="dot"></span> Amazon Delivery Service Partner · Station DOB7</span>
      <h1 class="hero__title"><span class="stagger" style="--d:1">Every package.</span><span class="stagger" style="--d:2">Every door.</span><span class="stagger grad" style="--d:3">On time.</span></h1>
      <p class="hero__lead stagger" style="--d:4">Lelit Logistics runs last-mile delivery out of Glastonbury, Connecticut — moving thousands of packages a day with a crew that takes safety, precision, and people seriously.</p>
      <div class="hero__actions stagger" style="--d:5"><a href="#careers" class="btn btn--orange">Drive with us <span class="arrow">↗</span></a><a href="#contact" class="btn btn--ghost">Partner with us</a></div>
    </div>
    <div class="hero__meta stagger" style="--d:6"><div><strong>35</strong><span>drivers daily</span></div><div><strong>DOB7</strong><span>Glastonbury, CT</span></div><div><strong>Fantastic+</strong><span>safety standard</span></div></div>
  </div>
</section>
<style>
.hero{position:relative;min-height:min(820px,88vh);padding-block:clamp(5rem,11vw,9rem) clamp(4rem,8vw,6rem);overflow:hidden;display:flex;align-items:center}.hero__media{position:absolute;inset:0 0 0 42%;overflow:hidden}.hero__media img{position:absolute;inset:-3%;width:106%;height:106%;object-fit:cover;object-position:58% center;animation:heroFloat 14s ease-in-out infinite alternate;filter:saturate(.92) contrast(1.04)}@keyframes heroFloat{from{transform:scale(1.01) translate3d(-.5%,0,0)}to{transform:scale(1.055) translate3d(.5%,-.5%,0)}}.hero__wash{position:absolute;inset:0;background:linear-gradient(90deg,var(--bg) 0%,rgba(5,10,15,.93) 8%,rgba(5,10,15,.48) 38%,rgba(5,10,15,.08) 70%),linear-gradient(0deg,rgba(5,10,15,.62),transparent 45%)}.hero__bg{position:absolute;inset:0;pointer-events:none}.hero__grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(90deg,#000 0%,rgba(0,0,0,.8) 40%,transparent 78%)}.hero__glow{position:absolute;left:-8%;top:5%;width:55vw;height:55vw;background:radial-gradient(circle,rgba(32,136,248,.14),transparent 65%);filter:blur(20px)}.hero__inner{position:relative;z-index:1;width:100%}.hero__copy{width:min(650px,58%);text-align:left}.hero__title{font-size:clamp(3.4rem,7.6vw,7rem);margin:1.5rem 0;letter-spacing:-.045em;line-height:.93}.hero__title span{display:block}.hero__lead{max-width:49ch;color:var(--fg-soft);font-size:clamp(1.05rem,1rem + .3vw,1.25rem)}.hero__actions{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:2rem}.hero__meta{display:flex;gap:clamp(1.6rem,4vw,3.5rem);margin-top:clamp(3rem,7vw,5rem);padding-top:1.7rem;border-top:1px solid rgba(255,255,255,.12);width:min(650px,58%)}.hero__meta div{display:flex;flex-direction:column}.hero__meta strong{font-family:var(--font-display);font-size:1.65rem}.hero__meta span{font-size:.82rem;color:var(--fg-faint)}.stagger{opacity:0;transform:translateY(20px);animation:rise .9s var(--ease) forwards;animation-delay:calc(var(--d)*.09s + .1s)}@keyframes rise{to{opacity:1;transform:none}}@media(max-width:900px){.hero{min-height:auto;padding-top:5rem;padding-bottom:0;display:block}.hero__media{position:relative;inset:auto;width:100%;height:58vw;min-height:390px;margin-top:3rem;order:2}.hero__media img{object-position:center}.hero__wash{background:linear-gradient(0deg,var(--bg) 0%,transparent 25%),linear-gradient(180deg,var(--bg) 0%,transparent 22%)}.hero__copy,.hero__meta{width:100%;max-width:650px;margin-inline:auto}.hero__copy{text-align:center}.hero__lead{margin-inline:auto}.hero__actions,.hero__meta{justify-content:center}.hero__inner{display:contents}.hero__copy{padding-inline:var(--wrap-pad,1.25rem)}.hero__meta{padding-inline:1.25rem;margin-bottom:0}}@media(max-width:620px){.hero__media{height:72vw;min-height:340px}.hero__meta{gap:1.25rem;text-align:center;flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){.stagger{opacity:1;transform:none;animation:none}.hero__media img{animation:none}}
</style>