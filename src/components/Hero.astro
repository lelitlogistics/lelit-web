---
const heroImage = 'https://upload.wikimedia.org/wikipedia/commons/4/4f/2025-04-23_13_31_59_Electric_Amazon_delivery_vehicle_along_Aquetong_Lane_in_the_Mountainview_section_of_Ewing_Township%2C_Mercer_County%2C_New_Jersey.jpg';
---
<section class="hero" id="main">
  <div class="hero__media" aria-hidden="true"><img src={heroImage} alt="" fetchpriority="high"/><div class="hero__wash"></div></div>
  <div class="hero__bg" aria-hidden="true"><div class="hero__grid"></div><div class="hero__glow"></div></div>
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <span class="pill stagger" style="--d:0"><span class="dot"></span> Amazon Delivery Service Partner · Station DOB7</span>
      <h1 class="hero__title"><span class="stagger" style="--d:1">Every package.</span><span class="stagger" style="--d:2">Every door.</span><span class="stagger grad" style="--d:3">On time.</span></h1>
      <p class="hero__lead stagger" style="--d:4">Lelit Logistics runs last-mile delivery out of Glastonbury, Connecticut — moving thousands of packages a day with a crew that takes safety, precision, and people seriously.</p>
      <div class="hero__actions stagger" style="--d:5"><a href="#careers" class="btn btn--orange">Drive with us <span class="arrow">↗</span></a><a href="#contact" class="btn btn--ghost">Partner with us</a></div>
      <div class="hero__meta stagger" style="--d:6"><div><strong>35</strong><span>drivers daily</span></div><div><strong>DOB7</strong><span>Glastonbury, CT</span></div><div><strong>Fantastic+</strong><span>safety standard</span></div></div>
    </div>
  </div>
  <span class="hero__credit">Photo: Famartin · CC BY-SA 4.0</span>
  <span class="hero__scroll" aria-hidden="true">SCROLL <i></i></span>
</section>
<style>
.hero{position:relative;min-height:min(900px,94vh);overflow:hidden;display:flex;align-items:center;padding-block:clamp(7rem,11vw,9rem) clamp(4rem,8vw,6rem);background:var(--bg)}
.hero__media{position:absolute;inset:0;overflow:hidden}
.hero__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:64% center;filter:saturate(.94) contrast(1.03)}
.hero__wash{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,10,15,.99) 0%,rgba(5,10,15,.97) 25%,rgba(5,10,15,.83) 38%,rgba(5,10,15,.34) 56%,rgba(5,10,15,.07) 76%,rgba(5,10,15,.02) 100%),linear-gradient(0deg,rgba(5,10,15,.45),transparent 48%)}
.hero__bg{position:absolute;inset:0;pointer-events:none}.hero__grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(90deg,#000 0%,rgba(0,0,0,.45) 36%,transparent 58%)}.hero__glow{position:absolute;left:-12%;top:3%;width:58vw;height:58vw;background:radial-gradient(circle,rgba(32,136,248,.12),transparent 65%);filter:blur(24px)}
.hero__inner{position:relative;z-index:4;width:100%}.hero__copy{width:min(650px,46%);text-align:left}.hero__title{font-size:clamp(3.6rem,6.6vw,6.6rem);margin:1.45rem 0;letter-spacing:-.045em;line-height:.93;text-wrap:balance}.hero__title span{display:block}.hero__lead{max-width:46ch;color:var(--fg-soft);font-size:clamp(1.05rem,1rem + .3vw,1.22rem)}.hero__actions{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:2rem}.hero__meta{display:flex;gap:clamp(1.6rem,3.6vw,3.2rem);margin-top:clamp(3rem,6vw,4.6rem);padding-top:1.5rem;border-top:1px solid rgba(255,255,255,.12);max-width:620px}.hero__meta div{display:flex;flex-direction:column}.hero__meta strong{font-family:var(--font-display);font-size:1.55rem}.hero__meta span{font-size:.82rem;color:var(--fg-faint)}.hero__credit{position:absolute;z-index:5;right:4.6rem;bottom:1.6rem;font-size:.55rem;letter-spacing:.04em;color:rgba(255,255,255,.36)}.hero__scroll{position:absolute;z-index:5;right:clamp(1rem,3vw,2.5rem);bottom:2rem;display:flex;align-items:center;gap:.7rem;font-size:.62rem;letter-spacing:.18em;color:rgba(255,255,255,.55);writing-mode:vertical-rl}.hero__scroll i{display:block;width:1px;height:38px;background:linear-gradient(var(--orange),transparent)}.stagger{opacity:0;transform:translateY(20px);animation:rise .9s var(--ease) forwards;animation-delay:calc(var(--d)*.09s + .1s)}@keyframes rise{to{opacity:1;transform:none}}
@media(max-width:1100px){.hero__copy{width:min(610px,52%)}.hero__media img{object-position:66% center}}
@media(max-width:900px){.hero{min-height:auto;display:block;padding:5.5rem 0 0}.hero__inner{padding-bottom:2.5rem}.hero__copy{width:100%;max-width:680px;margin-inline:auto;text-align:center;padding-inline:1.25rem}.hero__lead{margin-inline:auto}.hero__actions,.hero__meta{justify-content:center}.hero__meta{margin-inline:auto}.hero__media{position:relative;width:100%;height:min(72vw,620px);min-height:420px}.hero__media img{object-position:58% center}.hero__wash{background:linear-gradient(180deg,var(--bg) 0%,rgba(5,10,15,.4) 13%,transparent 32%),linear-gradient(0deg,var(--bg) 0%,rgba(5,10,15,.16) 20%,transparent 46%)}.hero__scroll,.hero__credit{display:none}}
@media(max-width:620px){.hero__title{font-size:clamp(3rem,15vw,4.6rem)}.hero__media{height:82vw;min-height:350px;max-height:500px}.hero__media img{object-position:52% center}.hero__meta{gap:1.2rem;text-align:center;flex-wrap:wrap}}
@media(prefers-reduced-motion:reduce){.stagger{opacity:1;transform:none;animation:none}}
</style>